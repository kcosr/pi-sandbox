[Unit]
Description=Pi Sandbox managed configuration and audit service
After=network.target

[Service]
Type=simple
ExecStart=/usr/libexec/pi-sandbox-service/pi-sandbox-service --manifest /etc/pi-sandbox-service/main/service.toml
User=root
Group=root
RuntimeDirectory=pi-sandbox
RuntimeDirectoryMode=0755
UMask=0077
StandardOutput=journal
StandardError=journal
MemoryMax=4G
TasksMax=256
LimitNOFILE=16384
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
DevicePolicy=closed
ReadOnlyPaths=/dev
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/pi-sandbox
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
