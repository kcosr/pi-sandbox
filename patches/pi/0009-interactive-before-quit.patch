 	private isShuttingDown = false;
+	private beforeQuitController?: AbortController;
 
 	private async shutdown(options?: { fromSignal?: boolean }): Promise<void> {
 		if (this.isShuttingDown) return;
+		if (options?.fromSignal) {
+			this.beforeQuitController?.abort();
+		} else if (this.beforeQuitController) {
+			return;
+		} else if (this.options.beforeInteractiveQuit) {
+			const controller = new AbortController();
+			this.beforeQuitController = controller;
+			try {
+				const proceed = await this.options.beforeInteractiveQuit(
+					this.session.extensionRunner.createCommandContext(), controller.signal,
+				);
+				if (controller.signal.aborted || this.isShuttingDown) return;
+				if (!proceed) {
+					this.shutdownRequested = false;
+					return;
+				}
+			} catch {
+				if (!controller.signal.aborted) {
+					this.shutdownRequested = false;
+					this.showError("Could not complete exit. The session is still open.");
+				}
+				return;
+			} finally {
+				if (this.beforeQuitController === controller) this.beforeQuitController = undefined;
+			}
+		}
 		this.isShuttingDown = true;
 		// Keep signal handlers registered until terminal cleanup has completed.
 		// `signal-exit` checks the listener list during the same SIGTERM/SIGHUP
