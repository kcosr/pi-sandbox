+describe("interactive before-quit hook", () => {
+	function instance(hook: (context: unknown, signal: AbortSignal) => Promise<boolean>) {
+		const order: string[] = [];
+		const context = {};
+		return {
+			order, context,
+			isShuttingDown: false,
+			shutdownRequested: true,
+			options: { beforeInteractiveQuit: hook },
+			session: { extensionRunner: { createCommandContext: () => context } },
+			runtimeHost: { dispose: vi.fn(async () => { order.push("dispose"); }) },
+			themeController: { disableAutoSync: () => {} },
+			ui: { terminal: { drainInput: async () => { order.push("drain"); } } },
+			stop: vi.fn(() => { order.push("stop"); }),
+			showError: vi.fn(),
+			sessionManager: { isPersisted: () => false },
+		};
+	}
+	const shutdown = (InteractiveMode.prototype as unknown as {
+		shutdown(options?: { fromSignal?: boolean }): Promise<void>;
+	}).shutdown;
+
+	test("awaits the hook before terminal or runtime teardown", async () => {
+		const exited = new Error("test exit");
+		vi.spyOn(process, "exit").mockImplementation(() => { throw exited; });
+		const hook = vi.fn(async () => true);
+		const state = instance(hook);
+		hook.mockImplementation(async () => { state.order.push("hook"); return true; });
+		await expect(shutdown.call(state)).rejects.toBe(exited);
+		expect(hook).toHaveBeenCalledWith(state.context, expect.any(AbortSignal));
+		expect(state.order).toEqual(["hook", "drain", "stop", "dispose"]);
+	});
+
+	test.each([false, "reject"])("keeps the session alive when the hook returns %s", async (answer) => {
+		const exit = vi.spyOn(process, "exit").mockImplementation(() => undefined as never);
+		const state = instance(async () => {
+			if (answer === "reject") throw new Error("test failure");
+			return false;
+		});
+		await shutdown.call(state);
+		expect(state.isShuttingDown).toBe(false);
+		expect(state.shutdownRequested).toBe(false);
+		expect(state.order).toEqual([]);
+		expect(exit).not.toHaveBeenCalled();
+	});
+
+	test("signals bypass the prompt", async () => {
+		const exited = new Error("test exit");
+		vi.spyOn(process, "exit").mockImplementation(() => { throw exited; });
+		const hook = vi.fn(async () => true);
+		const state = instance(hook);
+		await expect(shutdown.call(state, { fromSignal: true })).rejects.toBe(exited);
+		expect(hook).not.toHaveBeenCalled();
+		expect(state.runtimeHost.dispose).toHaveBeenCalledOnce();
+	});
+
+	test("a signal aborts a pending prompt; repeated quit cannot open a second prompt", async () => {
+		const exited = new Error("test exit");
+		vi.spyOn(process, "exit").mockImplementation(() => { throw exited; });
+		let signal: AbortSignal | undefined;
+		const hook = vi.fn((_context: unknown, pending: AbortSignal) => {
+			signal = pending;
+			return new Promise<boolean>((resolve) => pending.addEventListener("abort", () => resolve(false), { once: true }));
+		});
+		const state = instance(hook);
+		const pending = shutdown.call(state);
+		await shutdown.call(state);
+		expect(hook).toHaveBeenCalledOnce();
+		await expect(shutdown.call(state, { fromSignal: true })).rejects.toBe(exited);
+		await pending;
+		expect(signal?.aborted).toBe(true);
+		expect(state.runtimeHost.dispose).toHaveBeenCalledOnce();
+		expect(state.isShuttingDown).toBe(true);
+	});
+});
