diff --git a/packages/coding-agent/test/managed-session-sharing.test.ts b/packages/coding-agent/test/managed-session-sharing.test.ts
new file mode 100644
index 0000000..4b1c1d8
--- /dev/null
+++ b/packages/coding-agent/test/managed-session-sharing.test.ts
@@ -0,0 +1,60 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { BUILTIN_SLASH_COMMANDS } from "../src/core/slash-commands.ts";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.ts";
+
+describe("managed session sharing", () => {
+	afterEach(() => {
+		vi.restoreAllMocks();
+		vi.unstubAllEnvs();
+	});
+
+	it("does not advertise sharing but retains local export", () => {
+		expect(BUILTIN_SLASH_COMMANDS.some((command) => command.name === "share")).toBe(false);
+		expect(BUILTIN_SLASH_COMMANDS.some((command) => command.name === "export")).toBe(true);
+	});
+
+	it.each(["auto", "gist", "radius"])(
+		"rejects %s sharing without accessing the session or exporting content",
+		async (destination) => {
+			const showError = vi.fn();
+			const context = new Proxy(
+				{ showError, settingsManager: { getSessionShareDestination: () => destination } },
+				{
+					get(target, property) {
+						if (property === "showError") return target.showError;
+						throw new Error(`Sharing must not access ${String(property)}`);
+					},
+				},
+			);
+			const handleShareCommand = Reflect.get(InteractiveMode.prototype, "handleShareCommand") as (
+				this: typeof context,
+			) => Promise<void>;
+			await handleShareCommand.call(context);
+			expect(showError).toHaveBeenCalledExactlyOnceWith("Session sharing is disabled in this distribution.");
+		},
+	);
+
+	it("offline mode blocks install telemetry and package checks before accessing session state", async () => {
+		vi.stubEnv("PI_OFFLINE", "1");
+		vi.stubEnv("PI_TELEMETRY", "1");
+		const fetch = vi.spyOn(globalThis, "fetch").mockRejectedValue(new Error("Unexpected external callback"));
+		const context = new Proxy(
+			{},
+			{
+				get(_target, property) {
+					throw new Error(`Offline checks must not access ${String(property)}`);
+				},
+			},
+		);
+		const reportInstallTelemetry = Reflect.get(InteractiveMode.prototype, "reportInstallTelemetry") as (
+			this: typeof context,
+			version: string,
+		) => void;
+		const checkForPackageUpdates = Reflect.get(InteractiveMode.prototype, "checkForPackageUpdates") as (
+			this: typeof context,
+		) => Promise<string[]>;
+		reportInstallTelemetry.call(context, "1.3.0");
+		await expect(checkForPackageUpdates.call(context)).resolves.toEqual([]);
+		expect(fetch).not.toHaveBeenCalled();
+	});
+});
