diff --git a/packages/coding-agent/test/managed-session-sharing.test.ts b/packages/coding-agent/test/managed-session-sharing.test.ts
new file mode 100644
index 0000000..df0afce
--- /dev/null
+++ b/packages/coding-agent/test/managed-session-sharing.test.ts
@@ -0,0 +1,28 @@
+import { describe, expect, it, vi } from "vitest";
+import { BUILTIN_SLASH_COMMANDS } from "../src/core/slash-commands.ts";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.ts";
+
+describe("managed session sharing", () => {
+	it("does not advertise sharing but retains local export", () => {
+		expect(BUILTIN_SLASH_COMMANDS.some((command) => command.name === "share")).toBe(false);
+		expect(BUILTIN_SLASH_COMMANDS.some((command) => command.name === "export")).toBe(true);
+	});
+
+	it("rejects sharing without accessing the session or exporting content", async () => {
+		const showError = vi.fn();
+		const context = new Proxy(
+			{ showError },
+			{
+				get(target, property) {
+					if (property === "showError") return target.showError;
+					throw new Error(`Sharing must not access ${String(property)}`);
+				},
+			},
+		);
+		const handleShareCommand = Reflect.get(InteractiveMode.prototype, "handleShareCommand") as (
+			this: typeof context,
+		) => Promise<void>;
+		await handleShareCommand.call(context);
+		expect(showError).toHaveBeenCalledExactlyOnceWith("Session sharing is disabled in this distribution.");
+	});
+});
