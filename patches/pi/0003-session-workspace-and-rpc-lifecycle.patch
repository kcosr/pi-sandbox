diff --git a/packages/coding-agent/test/managed-session-cwd.test.ts b/packages/coding-agent/test/managed-session-cwd.test.ts
new file mode 100644
index 0000000..1f41371
--- /dev/null
+++ b/packages/coding-agent/test/managed-session-cwd.test.ts
@@ -0,0 +1,143 @@
+import { mkdtempSync, mkdirSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, test, vi } from "vitest";
+import type { AgentSession } from "../src/core/agent-session.ts";
+import { createAgentSessionRuntime, type CreateAgentSessionRuntimeFactory } from "../src/core/agent-session-runtime.ts";
+import {
+	createAgentSessionServices,
+	createAgentSessionFromServices,
+	type AgentSessionServices,
+} from "../src/core/agent-session-services.ts";
+import { ModelRuntime } from "../src/core/model-runtime.ts";
+import { AuthStorage } from "../src/core/auth-storage.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { SettingsManager } from "../src/core/settings-manager.ts";
+import { restoreStdout } from "../src/core/output-guard.ts";
+import { main } from "../src/main.ts";
+
+const roots: string[] = [];
+afterEach(() => {
+	restoreStdout();
+	vi.restoreAllMocks();
+	vi.unstubAllEnvs();
+	for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true });
+});
+function fixture() {
+	const root = mkdtempSync(join(tmpdir(), "managed-session-cwd-"));
+	roots.push(root);
+	const cwd = join(root, "current");
+	const other = join(root, "foreign");
+	const agentDir = join(root, "agent");
+	for (const dir of [cwd, other, agentDir]) mkdirSync(dir);
+	const path = join(root, "foreign.jsonl");
+	writeFileSync(
+		path,
+		JSON.stringify({
+			type: "session",
+			version: 3,
+			id: "12345678-1234-4123-8123-123456789abc",
+			timestamp: new Date().toISOString(),
+			cwd: other,
+		}) + "\n",
+	);
+	const validateSessionCwd = vi.fn((candidate: string) => {
+		if (candidate !== cwd) throw new Error("Workspace rejected");
+	});
+	return { root, cwd, other, agentDir, path, validateSessionCwd };
+}
+
+describe("managed session workspace admission", () => {
+	test("checks initial CLI session selection before target settings and resources", async () => {
+		const f = fixture();
+		vi.stubEnv("PI_CODING_AGENT_DIR", f.agentDir);
+		vi.stubEnv("PI_OFFLINE", "1");
+		writeFileSync(join(f.agentDir, "settings.json"), JSON.stringify({ setupComplete: true }));
+		const settings = vi.spyOn(SettingsManager, "create");
+		const createModelRuntime = vi.fn().mockRejectedValue(new Error("Unexpected model initialization"));
+		await expect(
+			main(["--mode", "rpc", "--session", f.path, "--no-extensions"], {
+				validateSessionCwd: f.validateSessionCwd,
+				createModelRuntime,
+			}),
+		).rejects.toThrow("Workspace rejected");
+		expect(settings.mock.calls.some(([cwd]) => cwd === f.other)).toBe(false);
+		expect(createModelRuntime).not.toHaveBeenCalled();
+	});
+	test("rejects initial runtime before invoking its factory", async () => {
+		const f = fixture();
+		const factory = vi.fn<CreateAgentSessionRuntimeFactory>();
+		await expect(
+			createAgentSessionRuntime(factory, {
+				cwd: f.other,
+				agentDir: f.agentDir,
+				sessionManager: SessionManager.open(f.path),
+				validateSessionCwd: f.validateSessionCwd,
+			}),
+		).rejects.toThrow("Workspace rejected");
+		expect(factory).not.toHaveBeenCalled();
+	});
+	test("rejects switch and import before invalidating the healthy session or loading target resources", async () => {
+		const f = fixture();
+		const abort = vi.fn(async () => {});
+		const dispose = vi.fn();
+		const manager = SessionManager.create(f.cwd, join(f.root, "sessions"));
+		const session = {
+			sessionManager: manager,
+			sessionFile: manager.getSessionFile(),
+			abort,
+			dispose,
+			extensionRunner: { hasHandlers: () => false },
+		} as unknown as AgentSession;
+		const factory = vi.fn<CreateAgentSessionRuntimeFactory>().mockResolvedValue({
+			session,
+			services: { cwd: f.cwd, agentDir: f.agentDir } as AgentSessionServices,
+			diagnostics: [],
+			extensionsResult: {} as never,
+		});
+		const host = await createAgentSessionRuntime(factory, {
+			cwd: f.cwd,
+			agentDir: f.agentDir,
+			sessionManager: manager,
+			validateSessionCwd: f.validateSessionCwd,
+		});
+		await expect(host.switchSession(f.path)).rejects.toThrow("Workspace rejected");
+		await expect(host.importFromJsonl(f.path)).rejects.toThrow("Workspace rejected");
+		expect(factory).toHaveBeenCalledTimes(1);
+		expect(abort).not.toHaveBeenCalled();
+		expect(dispose).not.toHaveBeenCalled();
+		expect(host.session).toBe(session);
+	});
+	test("rejects reload before project settings or resources are read", async () => {
+		const f = fixture();
+		const modelRuntime = await ModelRuntime.create({
+			credentials: AuthStorage.inMemory(),
+			modelsPath: null,
+			includeBuiltinCatalog: false,
+			refreshOnCreate: false,
+		});
+		const services = await createAgentSessionServices({
+			cwd: f.cwd,
+			agentDir: f.agentDir,
+			modelRuntime,
+			resourceLoaderOptions: { noExtensions: true, noSkills: true, noThemes: true, noPromptTemplates: true },
+		});
+		const { session } = await createAgentSessionFromServices({
+			services,
+			sessionManager: SessionManager.inMemory(f.cwd),
+			validateSessionCwd: f.validateSessionCwd,
+		});
+		const settings = vi.spyOn(services.settingsManager, "reload");
+		const resources = vi.spyOn(services.resourceLoader, "reload");
+		f.validateSessionCwd.mockImplementation(() => {
+			throw new Error("Workspace changed");
+		});
+		try {
+			await expect(session.reload()).rejects.toThrow("Workspace changed");
+			expect(settings).not.toHaveBeenCalled();
+			expect(resources).not.toHaveBeenCalled();
+		} finally {
+			session.dispose();
+		}
+	});
+});
