diff --git a/packages/coding-agent/test/managed-version.test.ts b/packages/coding-agent/test/managed-version.test.ts
new file mode 100644
index 0000000..f9b4c3e
--- /dev/null
+++ b/packages/coding-agent/test/managed-version.test.ts
@@ -0,0 +1,30 @@
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, expect, test, vi } from "vitest";
+import { VERSION } from "../src/config.ts";
+import { restoreStdout } from "../src/core/output-guard.ts";
+import { main } from "../src/main.ts";
+
+let agentDir: string;
+beforeEach(() => {
+	agentDir = mkdtempSync(join(tmpdir(), "pi-managed-version-"));
+	vi.stubEnv("PI_CODING_AGENT_DIR", agentDir);
+	vi.stubEnv("PI_OFFLINE", "1");
+});
+afterEach(() => {
+	restoreStdout();
+	vi.restoreAllMocks();
+	vi.unstubAllEnvs();
+	rmSync(agentDir, { recursive: true, force: true });
+});
+test.each([undefined, "1.1.0+ps.0.6.0", "1.1.0+ps.0.6.0.dev.g1234567"])(
+	"version output accepts a presentation override: %s", async (displayVersion) => {
+		const log = vi.spyOn(console, "log").mockImplementation(() => {});
+		const exit = new Error("version exit");
+		vi.spyOn(process, "exit").mockImplementation(() => { throw exit; });
+		await expect(main(["--version"], displayVersion === undefined ? {} : { displayVersion })).rejects.toBe(exit);
+		expect(log).toHaveBeenCalledExactlyOnceWith(displayVersion ?? VERSION);
+		expect(VERSION).toBe("1.1.0");
+	},
+);
