new file mode 100644
index 0000000..9e9bdcf
--- /dev/null
+++ b/packages/codemode/test/managed-limits.test.ts
@@ -0,0 +1,109 @@
+import { afterEach, describe, expect, it } from "vitest";
+import { CodemodeSandbox } from "../src/index.ts";
+const sandboxes: CodemodeSandbox[] = [];
+afterEach(async () => {
+	await Promise.all(sandboxes.splice(0).map((sandbox) => sandbox.close()));
+});
+function create(options: ConstructorParameters<typeof CodemodeSandbox>[0]) {
+	const sandbox = new CodemodeSandbox({ timeoutMs: 3000, ...options });
+	sandboxes.push(sandbox);
+	return sandbox;
+}
+describe("managed VM limits", () => {
+	it("counts discovery helpers and tool calls against the same budget", async () => {
+		let calls = 0;
+		const sandbox = create({
+			maxCalls: 2,
+			globals: [
+				{
+					name: "discover",
+					execute: () => {
+						calls++;
+					},
+				},
+			],
+			tools: [
+				{
+					name: "echo",
+					execute: () => {
+						calls++;
+					},
+				},
+			],
+		});
+		const result = await sandbox.execute("await discover(); await tools.echo(); await discover();");
+		expect(result).toMatchObject({ ok: false, error: { message: "Script bridge call limit exceeded" } });
+		expect(calls).toBe(2);
+	});
+	it("rejects excess outstanding bridge calls without dispatching them", async () => {
+		let calls = 0;
+		const sandbox = create({
+			maxConcurrentCalls: 1,
+			tools: [
+				{
+					name: "wait",
+					execute: (_args, { signal }) => {
+						calls++;
+						return new Promise((resolve) =>
+							signal.addEventListener("abort", () => resolve(null), { once: true }),
+						);
+					},
+				},
+			],
+		});
+		expect(await sandbox.execute("await Promise.all([tools.wait(), tools.wait()]);")).toMatchObject({ ok: false });
+		expect(calls).toBe(1);
+	});
+	it("bounds returned values as well as emitted output by UTF-8 byte size", async () => {
+		const sandbox = create({ maxOutputBytes: 100 });
+		expect(await sandbox.execute("return 'é'.repeat(51);")).toMatchObject({
+			ok: false,
+			error: { message: "Script output exceeds configured byte limit" },
+		});
+		expect(await sandbox.execute("text('é'.repeat(51));")).toMatchObject({ ok: false });
+	});
+	it("waits for aborted nested cleanup before the outer result settles", async () => {
+		let cleaned = false;
+		const sandbox = create({
+			awaitToolCleanup: true,
+			tools: [
+				{
+					name: "wait",
+					execute: (_args, { signal }) =>
+						new Promise((resolve) =>
+							signal.addEventListener(
+								"abort",
+								() => {
+									setTimeout(() => {
+										cleaned = true;
+										resolve(null);
+									}, 30);
+								},
+								{ once: true },
+							),
+						),
+				},
+			],
+		});
+		await sandbox.execute("tools.wait(); return 1;");
+		expect(cleaned).toBe(true);
+	});
+	it("rejects names that collide after normalization", () => {
+		expect(() =>
+			create({
+				rejectToolAliases: true,
+				tools: [
+					{ name: "a-b", execute: () => {} },
+					{ name: "a_b", execute: () => {} },
+				],
+			}),
+		).toThrow("ambiguous");
+	});
+	it("has no host APIs or module imports", async () => {
+		const sandbox = create({});
+		expect(
+			await sandbox.execute("return [typeof process, typeof require, typeof fetch, typeof models];"),
+		).toMatchObject({ ok: true, value: ["undefined", "undefined", "undefined", "undefined"] });
+		expect(await sandbox.execute("await import('node:fs');")).toMatchObject({ ok: false });
+	});
+});
