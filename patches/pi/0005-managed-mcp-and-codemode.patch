@@ -0,0 +1,400 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { LATEST_PROTOCOL_VERSION, McpSessionExpiredError, type Tool } from "@earendil-works/pi-mcp";
+import { createInMemoryTransportPair } from "@earendil-works/pi-mcp/testing";
+import { McpServerConnection } from "../src/extensions/mcp/runtime.ts";
+import { createMcpExtension } from "../src/extensions/mcp/index.ts";
+import { convertMcpResult } from "../src/extensions/mcp/tools.ts";
+import type { ExtensionAPI, ExtensionContext, ToolDefinition } from "../src/core/extensions/types.ts";
+
+const cleanup: (() => Promise<unknown>)[] = [];
+afterEach(async () => {
+	await Promise.all(cleanup.splice(0).map((close) => close()));
+});
+const entry = {
+	name: "docs",
+	config: { url: "https://unused.invalid/mcp?user=alice", exposure: "direct" as const },
+	source: "admin",
+};
+
+function server(tools: Tool[] = [{ name: "echo", inputSchema: { type: "object" } }]) {
+	const pair = createInMemoryTransportPair();
+	const methods: string[] = [];
+	let initialize: unknown;
+	pair.server.onMessage((message) => {
+		if (!("method" in message) || !("id" in message)) return;
+		methods.push(message.method);
+		if (message.method === "initialize") initialize = message.params;
+		const result =
+			message.method === "initialize"
+				? {
+						protocolVersion: LATEST_PROTOCOL_VERSION,
+						serverInfo: { name: "fixture", version: "1" },
+						capabilities: { tools: {}, resources: {}, prompts: {} },
+					}
+				: message.method === "tools/list"
+					? { tools }
+					: { content: [{ type: "text", text: "ok" }] };
+		queueMicrotask(() => void pair.server.send({ jsonrpc: "2.0", id: message.id, result }));
+	});
+	void pair.server.start();
+	return { ...pair, methods, initialize: () => initialize };
+}
+
+describe("managed MCP integration seams", () => {
+	it("advertises no roots or unrelated capabilities and performs tools-only setup without OAuth", async () => {
+		const fixture = server();
+		const transport = vi.fn((_entry, _cwd, auth) => {
+			expect(auth).toBeUndefined();
+			return fixture.client;
+		});
+		const connection = new McpServerConnection({
+			entry,
+			cwd: process.cwd(),
+			createTransport: transport,
+			authentication: false,
+			toolsOnly: true,
+			onTools: () => {},
+		});
+		cleanup.push(() => connection.close());
+		await connection.getClient();
+		expect(connection.oauthUrl).toBeUndefined();
+		expect(fixture.methods).toEqual(["initialize", "tools/list"]);
+		expect(fixture.initialize()).toMatchObject({ capabilities: {} });
+		expect(connection.hasResources).toBe(false);
+	});
+
+	it("coalesces refresh notifications without losing a change received during an in-flight listing", async () => {
+		const pair = createInMemoryTransportPair();
+		let lists = 0;
+		let delayed: (() => Promise<void>) | undefined;
+		pair.server.onMessage((message) => {
+			if (!("method" in message) || !("id" in message)) return;
+			if (message.method === "initialize") {
+				void pair.server.send({
+					jsonrpc: "2.0",
+					id: message.id,
+					result: {
+						protocolVersion: LATEST_PROTOCOL_VERSION,
+						serverInfo: { name: "fixture", version: "1" },
+						capabilities: { tools: {} },
+					},
+				});
+			} else {
+				const number = ++lists;
+				const send = () =>
+					pair.server.send({
+						jsonrpc: "2.0",
+						id: message.id,
+						result: { tools: [{ name: `tool${number}`, inputSchema: { type: "object" } }] },
+					});
+				if (number === 2) delayed = send;
+				else void send();
+			}
+		});
+		await pair.server.start();
+		const catalogs: string[][] = [];
+		const connection = new McpServerConnection({
+			entry,
+			cwd: process.cwd(),
+			createTransport: () => pair.client,
+			authentication: false,
+			toolsOnly: true,
+			onTools: (connection) => catalogs.push(connection.tools.map((tool) => tool.name)),
+		});
+		cleanup.push(() => connection.close());
+		await connection.getClient();
+		await pair.server.send({ jsonrpc: "2.0", method: "notifications/tools/list_changed" });
+		await vi.waitFor(() => expect(delayed).toBeDefined());
+		await pair.server.send({ jsonrpc: "2.0", method: "notifications/tools/list_changed" });
+		await delayed!();
+		await vi.waitFor(() => expect(catalogs.at(-1)).toEqual(["tool3"]));
+		expect(lists).toBe(3);
+	});
+
+	it("never replays an expired tools/call or reconnects after approval", async () => {
+		const fixture = server();
+		let dispatched = 0;
+		const send = fixture.client.send.bind(fixture.client);
+		fixture.client.send = async (message) => {
+			if ("method" in message && message.method === "tools/call") {
+				dispatched++;
+				throw new McpSessionExpiredError("gone");
+			}
+			return send(message);
+		};
+		const transport = vi.fn(() => fixture.client);
+		const connection = new McpServerConnection({
+			entry,
+			cwd: process.cwd(),
+			createTransport: transport,
+			authentication: false,
+			toolsOnly: true,
+			onTools: () => {},
+		});
+		cleanup.push(() => connection.close());
+		await connection.getClient();
+		await expect(connection.callTool("echo", {}, {})).rejects.toThrow();
+		await expect(connection.callTool("echo", {}, {})).rejects.toThrow("unavailable");
+		expect(dispatched).toBe(1);
+		expect(transport).toHaveBeenCalledTimes(1);
+	});
+
+	it("rejects a catalog before any tools are published and ignores extension servers and management", async () => {
+		const fixture = server([
+			{ name: "good", inputSchema: { type: "object" } },
+			{ name: "bad", inputSchema: { type: "object" } },
+		]);
+		const handlers = new Map<string, (event: unknown, ctx: ExtensionContext) => unknown>();
+		const registerTool = vi.fn();
+		const getMcpServers = vi.fn();
+		const registerCommand = vi.fn();
+		const nonemptyCatalogs: string[][] = [];
+		const pi = {
+			on: (name: string, handler: (event: unknown, ctx: ExtensionContext) => unknown) => handlers.set(name, handler),
+			registerTool,
+			registerCommand,
+			getMcpServers,
+			registerToolRenderer: () => {},
+			getAllTools: () => [],
+			getActiveTools: () => [],
+			setActiveTools: () => {},
+		} as unknown as ExtensionAPI;
+		await createMcpExtension({
+			toolsOnly: true,
+			authentication: false,
+			management: false,
+			serverLogging: false,
