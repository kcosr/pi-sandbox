@@ -0,0 +1,77 @@
+import { chmodSync, mkdirSync, mkdtempSync, realpathSync, rmSync, symlinkSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+describe("build-selected managed host tools", () => {
+	let root: string;
+	beforeEach(() => {
+		root = realpathSync(mkdtempSync(join(tmpdir(), "pi-managed-host-tools-")));
+		vi.resetModules();
+		vi.stubEnv("PI_CODING_AGENT_DIR", join(root, "agent"));
+		vi.stubEnv("PATH", root);
+		vi.stubEnv("PI_OFFLINE", "1");
+		mkdirSync(join(root, "agent", "bin"), { recursive: true });
+	});
+	afterEach(() => {
+		vi.unstubAllGlobals();
+		vi.unstubAllEnvs();
+		rmSync(root, { recursive: true, force: true });
+	});
+	function executable(path: string) {
+		writeFileSync(path, "#!/bin/sh\nexit 0\n", { mode: 0o755 });
+		return path;
+	}
+	it("uses the selected executable before a conflicting user cache or PATH tool", async () => {
+		const selected = executable(join(root, "selected fd"));
+		executable(join(root, "fd"));
+		executable(join(root, "agent", "bin", "fd"));
+		vi.stubGlobal("PI_SANDBOX_HOST_TOOLS", { fd: selected });
+		const { getToolPath, ensureTool } = await import("../src/utils/tools-manager.ts");
+		expect(getToolPath("fd")).toBe(selected);
+		expect(await ensureTool("fd")).toBe(selected);
+	});
+	it("rejects missing selections without falling back or downloading", async () => {
+		executable(join(root, "agent", "bin", "rg"));
+		vi.stubGlobal("PI_SANDBOX_HOST_TOOLS", { rg: join(root, "missing") });
+		const fetch = vi.fn();
+		vi.stubGlobal("fetch", fetch);
+		const { getToolPath, ensureTool } = await import("../src/utils/tools-manager.ts");
+		expect(() => getToolPath("rg")).toThrow(/Build-selected rg is unavailable/);
+		await expect(ensureTool("rg")).rejects.toThrow(/Build-selected rg is unavailable/);
+		expect(fetch).not.toHaveBeenCalled();
+	});
+	it("rejects directories, non-executable files and escaping relative selections", async () => {
+		const { getToolPath } = await import("../src/utils/tools-manager.ts");
+		for (const selected of [root, executable(join(root, "not-executable"))]) {
+			if (selected !== root) chmodSync(selected, 0o644);
+			vi.stubGlobal("PI_SANDBOX_HOST_TOOLS", { fd: selected });
+			expect(() => getToolPath("fd")).toThrow(/Build-selected fd is unavailable/);
+		}
+		vi.stubGlobal("PI_SANDBOX_HOST_TOOLS", { fd: "../fd" });
+		expect(() => getToolPath("fd")).toThrow(/Invalid build-selected fd path/);
+	});
+	it("preserves ordinary discovery for tools without a build selection", async () => {
+		const cached = executable(join(root, "agent", "bin", "rg"));
+		vi.stubGlobal("PI_SANDBOX_HOST_TOOLS", {});
+		const { getToolPath } = await import("../src/utils/tools-manager.ts");
+		expect(getToolPath("rg")).toBe(cached);
+	});
+	it("resolves a relocated package-relative selection against the compiled executable", async () => {
+		const packageRoot = join(root, "package with spaces");
+		mkdirSync(join(packageRoot, "tools", "bin"), { recursive: true });
+		const selected = executable(join(packageRoot, "tools", "bin", "rg"));
+		executable(join(packageRoot, "pi-sandbox"));
+		const launcher = join(root, "launcher");
+		symlinkSync(join(packageRoot, "pi-sandbox"), launcher);
+		const descriptor = Object.getOwnPropertyDescriptor(process, "execPath")!;
+		try {
+			Object.defineProperty(process, "execPath", { ...descriptor, value: launcher });
+			vi.stubGlobal("PI_SANDBOX_HOST_TOOLS", { rg: "tools/bin/rg" });
+			const { getToolPath } = await import("../src/utils/tools-manager.ts");
+			expect(getToolPath("rg")).toBe(selected);
+		} finally {
+			Object.defineProperty(process, "execPath", descriptor);
+		}
+	});
+});
