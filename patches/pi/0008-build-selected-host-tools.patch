+// Replaced with immutable literals by the managed distribution build. Ordinary
+// Pi retains its cache/PATH/download behavior without a build selection.
+declare const PI_SANDBOX_HOST_TOOLS: Readonly<Partial<Record<"fd" | "rg", string>>> | undefined;
+
+function buildSelectedTool(tool: "fd" | "rg"): string | undefined {
+	if (typeof PI_SANDBOX_HOST_TOOLS === "undefined") return undefined;
+	const selected = PI_SANDBOX_HOST_TOOLS[tool];
+	if (selected === undefined) return undefined;
+	if (
+		typeof selected !== "string" ||
+		selected.includes("\0") ||
+		normalize(selected) !== selected ||
+		(!isAbsolute(selected) && selected !== `tools/bin/${tool}`)
+	)
+		throw new Error(`Invalid build-selected ${tool} path`);
+	const path = isAbsolute(selected) ? selected : join(dirname(realpathSync(process.execPath)), selected);
+	try {
+		if (!statSync(path).isFile()) throw new Error("not a regular file");
+		accessSync(path, constants.X_OK);
+	} catch (cause) {
+		throw new Error(`Build-selected ${tool} is unavailable: ${path}`, { cause });
+	}
+	return path;
+}
