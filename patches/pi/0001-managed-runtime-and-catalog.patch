+import { createAgentSessionFromServices, createAgentSessionServices } from "../src/core/agent-session-services.ts";
+import { AuthStorage } from "../src/core/auth-storage.ts";
+import type { ExtensionAPI, ToolDefinition } from "../src/core/extensions/types.ts";
+import { ModelRuntime } from "../src/core/model-runtime.ts";
+import { restoreStdout } from "../src/core/output-guard.ts";
+import type { CreateAgentSessionOptions } from "../src/core/sdk.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { main } from "../src/main.ts";
+
+const disabledTools = ["read", "grep", "find", "ls", "write", "edit", "powershell"];
+const selections = [["powershell"], ["*"], ["+powershell"], ["read", "write", "powershell"]];
+const definition = (name: string): ToolDefinition => ({
+	name,
+	label: name,
+	description: "Managed fixture tool",
+	parameters: Type.Object({}),
+	execute: async () => ({ content: [{ type: "text", text: "managed" }], details: {} }),
+});
+
+describe("managed built-in tool exclusion", () => {
+	let root: string;
+	let agentDir: string;
+	let modelRuntime: ModelRuntime;
+	let api: ExtensionAPI;
+
+	beforeEach(async () => {
+		root = mkdtempSync(join(tmpdir(), "pi-managed-tools-"));
+		agentDir = join(root, "agent");
+		mkdirSync(agentDir);
+		writeFileSync(join(agentDir, "settings.json"), JSON.stringify({ setupComplete: true }));
+		modelRuntime = await ModelRuntime.create({
+			credentials: AuthStorage.inMemory(),
+			modelsPath: null,
+			modelsStore: new InMemoryModelsStore(),
+			includeBuiltinCatalog: false,
+			allowModelNetwork: false,
+			refreshOnCreate: false,
+		});
+	});
+
+	afterEach(() => {
+		restoreStdout();
+		vi.restoreAllMocks();
+		vi.unstubAllEnvs();
+		rmSync(root, { recursive: true, force: true });
+	});
+
+	const factory = (pi: ExtensionAPI) => {
+		api = pi;
+		// This models an administrator allowing bash while disabling the other managed tools.
+		// Disabled tools are never registered, so stock definitions must not fill their names.
+		pi.registerTool(definition("bash"));
+	};
+
+	const assertNoStock = () => {
+		expect(api.getAllTools().every((tool) => tool.sourceInfo?.source !== "builtin")).toBe(true);
+		for (const name of disabledTools) expect(api.getAllTools().map((tool) => tool.name)).not.toContain(name);
+	};
+
+	test.each<{
+		label: string;
+		options: Pick<CreateAgentSessionOptions, "tools" | "excludeTools" | "noTools">;
+		expected: string[];
+	}>([
+		{ label: "recorded loadout", options: {}, expected: ["bash", "mcp__docs__enabled"] },
+		{ label: "managed builtin exclusion", options: { noTools: "builtin" }, expected: ["bash"] },
+		{ label: "explicit ceiling", options: { tools: ["mcp__docs__enabled"] }, expected: ["mcp__docs__enabled"] },
+		{ label: "disabled selection", options: { tools: ["powershell"] }, expected: [] },
+		{ label: "wildcard selection", options: { tools: ["*"] }, expected: ["bash", "mcp__docs__enabled"] },
+		{ label: "exclusion", options: { excludeTools: ["mcp__docs__enabled"] }, expected: ["bash"] },
+	])("keeps resume within current policy and $label", async ({ options, expected }) => {
+		const sessionManager = SessionManager.inMemory(root);
+		const recorded = ["bash", ...disabledTools, "mcp__docs__enabled", "mcp__docs__hidden", "mcp__docs__removed"];
+		sessionManager.appendMessage({
+			role: "system",
+			content: "",
+			toolsAdded: recorded.map((name) => ({ name, description: name, parameters: Type.Object({}) })),
+			timestamp: Date.now(),
+		});
+		const services = await createAgentSessionServices({
+			cwd: root,
+			agentDir,
+			modelRuntime,
+			resourceLoaderOptions: {
+				noExtensions: true,
+				noSkills: true,
+				noContextFiles: true,
+				extensionFactories: [
+					(pi) => {
+						factory(pi);
+						pi.registerTool({ ...definition("mcp__docs__enabled"), defaultActive: false });
+						pi.registerTool({ ...definition("mcp__docs__hidden"), exposure: "hidden" });
+					},
+				],
+			},
+		});
+		const { session } = await createAgentSessionFromServices({
+			services,
+			sessionManager,
+			includeBuiltinTools: false,
+			...options,
+		});
+		try {
+			await session.bindExtensions({});
+			expect(session.getActiveToolNames().sort()).toEqual(expected);
+			for (let generation = 0; generation < 2; generation++) {
+				api.registerTool({ ...definition("mcp__other__late"), defaultActive: false });
+				assertNoStock();
+				for (const name of [
+					...disabledTools,
+					...["bash", "mcp__docs__enabled"].filter((name) => !expected.includes(name)),
+					"mcp__docs__hidden",
+					"mcp__docs__removed",
+					...(options.tools?.includes("*") ? [] : ["mcp__other__late"]),
+				]) {
+					expect(session.getActiveToolNames()).not.toContain(name);
+					expect(session.getCallableToolNames()).not.toContain(name);
+				}
+				if (generation === 0) await session.reload();
+			}
+		} finally {
+			session.dispose();
+		}
+	});
+
+	test.each(selections)(
+		"cannot restore stock tools selected with %j through refresh, reload or recreation",
+		async (...tools) => {
+			const create = async () => {
+				const services = await createAgentSessionServices({
+					cwd: root,
+					agentDir,
+					modelRuntime,
+					resourceLoaderOptions: {
+						noExtensions: true,
+						noSkills: true,
+						noContextFiles: true,
+						extensionFactories: [factory],
+					},
+				});
+				return createAgentSessionFromServices({
+					services,
+					sessionManager: SessionManager.inMemory(root),
+					noTools: "builtin",
+					tools,
+					includeBuiltinTools: false,
+				});
+			};
+			for (let generation = 0; generation < 2; generation++) {
+				const { session } = await create();
+				try {
+					await session.bindExtensions({});
+					// The managed startup hook narrows activation before a slow MCP server registers.
+					api.setActiveTools(["bash"]);
+					api.registerTool(definition("mcp__docs__late"));
+					assertNoStock();
+					for (const name of disabledTools) {
+						expect(session.getActiveToolNames()).not.toContain(name);
+						expect(session.getCallableToolNames()).not.toContain(name);
+					}
+					if (tools.includes("*")) {
+						const tool = session.agent.state.tools.find((tool) => tool.name === "bash")!;
+						expect(await tool.execute("managed-call", {})).toMatchObject({ content: [{ text: "managed" }] });
+					}
+					await session.reload();
+					api.registerTool(definition("mcp__docs__after_reload"));
+					assertNoStock();
+				} finally {
+					session.dispose();
+				}
+			}
+		},
+	);
+
+	test.each([undefined, true])(
+		"preserves ordinary stock registration when the option is %s",
+		async (includeBuiltinTools) => {
+			const services = await createAgentSessionServices({
+				cwd: root,
+				agentDir,
+				modelRuntime,
+				resourceLoaderOptions: {
+					noExtensions: true,
+					noSkills: true,
+					noContextFiles: true,
+					extensionFactories: [factory],
+				},
+			});
+			const { session } = await createAgentSessionFromServices({
+				services,
+				sessionManager: SessionManager.inMemory(root),
+				noTools: "builtin",
+				tools: ["*"],
+				includeBuiltinTools,
+			});
+			try {
+				api.registerTool(definition("mcp__docs__late"));
+				expect(session.getAllTools().find((tool) => tool.name === "powershell")?.sourceInfo?.source).toBe(
+					"builtin",
+				);
+				expect(session.getAllTools().find((tool) => tool.name === "read")?.sourceInfo?.source).toBe("builtin");
+			} finally {
+				session.dispose();
+			}
+		},
+	);
+
+	test("forwards the embedding-only switch from main independently of user tool selections", async () => {
+		vi.stubEnv("PI_CODING_AGENT_DIR", agentDir);
+		vi.stubEnv("PI_OFFLINE", "1");
+		const stopped = new Error("Expected metadata exit");
+		vi.spyOn(process, "exit").mockImplementation(() => {
+			throw stopped;
+		});
+		vi.spyOn(process.stdout, "write").mockReturnValue(true);
+		await expect(
+			main(
+				[
+					"--help",
+					"--no-builtin-tools",
+					"--tools",
+					"*",
+					"--no-session",
+					"--no-extensions",
+					"--no-skills",
+					"--no-context-files",
+				],
+				{
+					includeBuiltinTools: false,
+					createModelRuntime: async () => modelRuntime,
+					extensionFactories: [factory],
+				},
+			),
+		).rejects.toBe(stopped);
+		api.registerTool(definition("mcp__docs__late"));
+		assertNoStock();
+	});
+});
