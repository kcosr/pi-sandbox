+import { mkdirSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { InMemoryModelsStore } from "@earendil-works/pi-ai";
+import { afterEach, beforeEach, describe, expect, test, vi } from "vitest";
+import { AuthStorage } from "../src/core/auth-storage.ts";
+import { ModelRuntime } from "../src/core/model-runtime.ts";
+
+describe("configured-only model runtime", () => {
+	let tempDir: string;
+	let modelsPath: string;
+
+	beforeEach(() => {
+		tempDir = join(tmpdir(), `pi-managed-models-${Date.now()}-${Math.random().toString(36).slice(2)}`);
+		mkdirSync(tempDir, { recursive: true });
+		modelsPath = join(tempDir, "models.json");
+	});
+
+	afterEach(() => {
+		rmSync(tempDir, { recursive: true, force: true });
+	});
+
+	async function createRuntime(modelsStore = new InMemoryModelsStore()): Promise<ModelRuntime> {
+		return ModelRuntime.create({
+			credentials: AuthStorage.inMemory({ openai: { type: "api_key", key: "test-key" } }),
+			modelsPath,
+			modelsStore,
+			allowModelNetwork: false,
+			refreshOnCreate: false,
+			includeBuiltinCatalog: false,
+		});
+	}
+
+	test("exposes only explicitly configured providers and models", async () => {
+		writeFileSync(
+			modelsPath,
+			JSON.stringify({
+				providers: {
+					openai: {
+						api: "openai-responses",
+						baseUrl: "https://api.openai.com/v1",
+						models: [{ id: "managed-model" }],
+					},
+				},
+			}),
+		);
+
+		const runtime = await createRuntime();
+
+		expect(runtime.getError()).toBeUndefined();
+		expect(runtime.getModels().map((model) => `${model.provider}/${model.id}`)).toEqual(["openai/managed-model"]);
+		expect(runtime.getAllModels()).toEqual(runtime.getModels());
+		expect(runtime.getModelsOfType("image")).toEqual([]);
+		expect(runtime.getModelsOfType("classifier")).toEqual([]);
+		expect(runtime.getProvider("openai")).toBeDefined();
+		expect(runtime.getProvider("anthropic")).toBeUndefined();
+		await expect(runtime.getAuth("openai")).resolves.toMatchObject({ auth: { apiKey: "test-key" } });
+		await expect(runtime.getAllAvailable()).resolves.toEqual(runtime.getModels());
+		await runtime.refresh({ allowNetwork: false });
+		expect(runtime.getAllModels().map((model) => model.id)).toEqual(["managed-model"]);
+		writeFileSync(modelsPath, JSON.stringify({ providers: {} }));
+		await runtime.refresh({ allowNetwork: false, providers: ["openai", "anthropic"] });
+		expect(runtime.getAllModels()).toEqual([]);
+		expect(runtime.getProviders()).toEqual([]);
+	});
+
+	test("does not restore a built-in provider after configured composition fails", async () => {
+		writeFileSync(modelsPath, JSON.stringify({ providers: { openai: { models: [{ id: "missing-api-and-url" }] } } }));
+
+		const runtime = await createRuntime();
+
+		expect(runtime.getError()).toContain('Provider "openai"');
+		expect(runtime.getProvider("openai")).toBeUndefined();
+		expect(runtime.getModels()).toEqual([]);
+	});
+
+	test("does not restore builtin models from a persisted catalog or fetch a remote catalog", async () => {
+		writeFileSync(modelsPath, JSON.stringify({ providers: { openai: { baseUrl: "https://example.invalid/v1" } } }));
+		const modelsStore = new InMemoryModelsStore();
+		const stock = await ModelRuntime.create({
+			credentials: AuthStorage.inMemory(),
+			modelsPath: null,
+			modelsStore: new InMemoryModelsStore(),
+			refreshOnCreate: false,
+		});
+		await modelsStore.write("openai", { models: stock.getAllModels("openai"), lastModified: Date.now() });
+		const read = vi.spyOn(modelsStore, "read");
+		const fetch = vi.spyOn(globalThis, "fetch").mockRejectedValue(new Error("Unexpected network access"));
+		try {
+			const runtime = await createRuntime(modelsStore);
+			await runtime.refresh({ allowNetwork: true });
+			expect(runtime.getError()).toBeUndefined();
+			expect(runtime.getAllModels()).toEqual([]);
+			expect(read).not.toHaveBeenCalled();
