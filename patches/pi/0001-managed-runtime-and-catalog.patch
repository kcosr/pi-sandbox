new file mode 100644
index 0000000..cf94854
--- /dev/null
+++ b/packages/coding-agent/test/managed-extensions.test.ts
@@ -0,0 +1,36 @@
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { describe, expect, test, vi } from "vitest";
+import { DefaultResourceLoader } from "../src/core/resource-loader.ts";
+import { builtInExtensions } from "../src/extensions/index.ts";
+
+describe("managed inline extension", () => {
+	test("loads only the forced inline factory with noExtensions, including after reload", async () => {
+		const tempDir = mkdtempSync(join(tmpdir(), "pi-managed-extensions-"));
+		const agentDir = join(tempDir, "agent");
+		const cwd = join(tempDir, "project");
+		const factory = vi.fn();
+		try {
+			for (const root of [agentDir, join(cwd, ".pi")]) {
+				mkdirSync(join(root, "extensions"), { recursive: true });
+				writeFileSync(join(root, "extensions", "unexpected.ts"), 'throw new Error("Must not load");');
+				writeFileSync(join(root, "settings.json"), JSON.stringify({ extensions: ["+builtin:mcp"] }));
+			}
+			const loader = new DefaultResourceLoader({
+				cwd,
+				agentDir,
+				noExtensions: true,
+				extensionFactories: [...builtInExtensions, { name: "managed", factory }],
+			});
+			for (let reload = 0; reload < 2; reload++) {
+				await loader.reload();
+				expect(loader.getExtensions().errors).toEqual([]);
+				expect(loader.getExtensions().extensions.map((extension) => extension.path)).toEqual(["<inline:managed>"]);
+			}
+			expect(factory).toHaveBeenCalledTimes(2);
+		} finally {
+			rmSync(tempDir, { recursive: true, force: true });
+		}
+	});
+});
diff --git a/packages/coding-agent/test/managed-main.test.ts b/packages/coding-agent/test/managed-main.test.ts
new file mode 100644
index 0000000..04def0a
--- /dev/null
+++ b/packages/coding-agent/test/managed-main.test.ts
@@ -0,0 +1,96 @@
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { InMemoryModelsStore } from "@earendil-works/pi-ai";
+import { afterEach, beforeEach, describe, expect, test, vi } from "vitest";
+import { AuthStorage } from "../src/core/auth-storage.ts";
+import { ModelRuntime, type ModelRuntimeFactory } from "../src/core/model-runtime.ts";
+import { restoreStdout } from "../src/core/output-guard.ts";
+import { main } from "../src/main.ts";
+
+describe("managed main runtime injection", () => {
+	let tempDir: string;
+	let agentDir: string;
+	let modelsPath: string;
+	let originalExitCode: typeof process.exitCode;
+
+	beforeEach(() => {
+		tempDir = mkdtempSync(join(tmpdir(), "pi-managed-main-"));
+		agentDir = join(tempDir, "agent");
+		mkdirSync(agentDir);
+		modelsPath = join(tempDir, "models.json");
+		writeFileSync(join(agentDir, "settings.json"), JSON.stringify({ setupComplete: true }));
+		writeFileSync(
+			modelsPath,
+			JSON.stringify({
+				providers: {
+					openai: { api: "openai-responses", baseUrl: "https://example.invalid/v1", models: [{ id: "managed" }] },
+					"openai-codex": {
+						api: "openai-codex-responses",
+						baseUrl: "https://example.invalid/v1",
+						models: [{ id: "managed" }],
+					},
+				},
+			}),
+		);
+		vi.stubEnv("PI_CODING_AGENT_DIR", agentDir);
+		vi.stubEnv("PI_OFFLINE", "1");
+		originalExitCode = process.exitCode;
+		process.exitCode = undefined;
+	});
+
+	afterEach(() => {
+		restoreStdout();
+		process.exitCode = originalExitCode;
+		vi.restoreAllMocks();
+		vi.unstubAllEnvs();
+		rmSync(tempDir, { recursive: true, force: true });
+	});
+
+	test.each([["--help"], ["--list-models"], ["--print"], ["--mode", "json"], ["--mode", "rpc"]])(
+		"fails startup through the injected factory for %s",
+		async (...args) => {
+			const failure = new Error("Managed initialization failed");
+			const createModelRuntime = vi.fn<ModelRuntimeFactory>().mockRejectedValue(failure);
+			await expect(
+				main([...args, "--no-session", "--no-extensions", "--no-skills", "--no-context-files"], {
+					createModelRuntime,
+				}),
+			).rejects.toBe(failure);
+			expect(createModelRuntime).toHaveBeenCalledExactlyOnceWith(
+				expect.objectContaining({
+					authPath: join(agentDir, "auth.json"),
+					modelsPath: join(agentDir, "models.json"),
+				}),
+			);
+		},
+	);
+
+	test.each([
+		{ args: ["auth", "check", "--json", "--provider", "openai"], output: '"status":"ready"' },
+		{ args: ["auth", "check", "--json", "--no-refresh", "--provider", "openai"], output: '"status":"ready"' },
+		{ args: ["auth", "print-api-key", "--provider", "openai"], output: "managed-key" },
+		{ args: ["auth", "print-bearer-token", "--provider", "openai-codex"], output: "managed-token" },
+	])("uses the injected catalog for $args", async ({ args, output }) => {
+		const credentials = AuthStorage.inMemory({
+			openai: { type: "api_key", key: "managed-key" },
+			"openai-codex": { type: "oauth", access: "managed-token", refresh: "unused", expires: Date.now() + 3_600_000 },
+		});
+		const createModelRuntime = vi.fn<ModelRuntimeFactory>((options) =>
+			ModelRuntime.create({
+				...options,
+				credentials,
+				modelsPath,
+				modelsStore: new InMemoryModelsStore(),
+				includeBuiltinCatalog: false,
+				allowModelNetwork: false,
+				refreshOnCreate: false,
+			}),
+		);
+		const write = vi.spyOn(process.stdout, "write").mockReturnValue(true);
+		await main(args, { createModelRuntime });
+		expect(createModelRuntime).toHaveBeenCalledOnce();
+		expect(write.mock.calls.map(([chunk]) => String(chunk)).join("")).toContain(output);
+		expect(process.exitCode ?? 0).toBe(0);
+	});
+});
