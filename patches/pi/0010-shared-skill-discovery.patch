+import { ProjectTrustStore } from "../src/core/trust-manager.ts";
+import { main } from "../src/main.ts";
+import * as theme from "../src/modes/interactive/theme/theme.ts";
+
+const modes = vi.hoisted(() => ({ rpc: vi.fn() }));
+vi.mock("../src/modes/index.ts", () => ({
+	InteractiveMode: class {},
+	runPrintMode: vi.fn(),
+	runRpcMode: modes.rpc,
+}));
+
+describe("main default skill roots", () => {
+	let root: string;
+	let cwd: string;
+	let agentDir: string;
+	let shared: string;
+	let sharedFile: string;
+	let createModelRuntime: ModelRuntimeFactory;
+	let originalExitCode: typeof process.exitCode;
+	const args = [
+		"--mode",
+		"rpc",
+		"--no-session",
+		"--no-extensions",
+		"--no-context-files",
+		"--no-prompt-templates",
+		"--no-themes",
+	];
+
+	beforeEach(() => {
+		root = mkdtempSync(join(tmpdir(), "pi-main-skills-"));
+		cwd = join(root, "workspace");
+		agentDir = join(root, "relocated-agent-state");
+		shared = join(root, "shared");
+		for (const path of [cwd, agentDir, shared, join(cwd, ".git")]) mkdirSync(path, { recursive: true });
+		sharedFile = join(shared, "SKILL.md");
+		writeFileSync(sharedFile, "---\nname: shared\ndescription: Shared fixture\n---\nBody");
+		writeFileSync(join(agentDir, "settings.json"), JSON.stringify({ setupComplete: true }));
+		const modelsPath = join(root, "models.json");
+		writeFileSync(
+			modelsPath,
+			JSON.stringify({
+				providers: {
