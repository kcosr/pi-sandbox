+++ b/packages/ai/test/explicit-cloud.test.ts
@@ -0,0 +1,193 @@
+import { mkdir, mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const host = vi.hoisted(() => ({ home: "" }));
+vi.mock("node:os", async (original) => ({
+	...(await original<typeof import("node:os")>()),
+	userInfo: () => ({ homedir: host.home }),
+}));
+
+import { AwsClient, ExternalAccountAuthorizedUserClient } from "google-auth-library";
+import {
+	createSelectedGoogleAuthClient,
+	parseGoogleCredentials,
+	readSelectedGoogleCredentials,
+	resolveSelectedAwsProfile,
+} from "../src/auth/explicit-cloud.ts";
+import { amazonBedrockProvider } from "../src/providers/amazon-bedrock.ts";
+import { googleVertexProvider } from "../src/providers/google-vertex.ts";
+import { authoritativeProviderEnv, explicitGoogleCredentials } from "../src/utils/provider-env.ts";
+
+const signal = () => new AbortController().signal;
+const context = (values: Record<string, string>) => ({
+	environment: authoritativeProviderEnv(values),
+	authoritative: true,
+	env: async (key: string) => values[key],
+	fileExists: vi.fn(async () => {
+		throw new Error("must not discover files");
+	}),
+});
+beforeEach(async () => {
+	host.home = await mkdtemp(join(tmpdir(), "pi-explicit-cloud-"));
+	await mkdir(join(host.home, ".aws"));
+});
+afterEach(async () => {
+	vi.unstubAllEnvs();
+	await rm(host.home, { recursive: true, force: true });
+});
+describe("explicit cloud credential sources", () => {
+	it("selects only the stored AWS profile from bounded immutable file inputs", async () => {
+		vi.stubEnv("AWS_ACCESS_KEY_ID", "ambient");
+		vi.stubEnv("AWS_SECRET_ACCESS_KEY", "ambient");
+		vi.stubEnv("AWS_PROFILE", "default");
+		vi.stubEnv("AWS_SHARED_CREDENTIALS_FILE", "/wrong-file");
+		await writeFile(
+			join(host.home, ".aws", "credentials"),
+			"[personal]\naws_access_key_id=selected\naws_secret_access_key=secret\n[default]\naws_access_key_id=wrong\naws_secret_access_key=wrong\n",
+		);
+		const resolved = await resolveSelectedAwsProfile("personal", {}, signal());
+		expect(resolved).toMatchObject({
+			AWS_ACCESS_KEY_ID: "selected",
+			AWS_SECRET_ACCESS_KEY: "secret",
+			AWS_PROFILE: "",
+			AWS_BEARER_TOKEN_BEDROCK: "",
+		});
+		const auth = await amazonBedrockProvider().auth.apiKey!.resolve({
+			ctx: context({
+				AWS_BEARER_TOKEN_BEDROCK: "admin",
+				AWS_ACCESS_KEY_ID: "admin",
+				AWS_SECRET_ACCESS_KEY: "admin",
+			}),
+			credential: { type: "api_key", env: { AWS_PROFILE: "personal" } },
+			signal: signal(),
+		});
+		expect(auth?.env?.AWS_ACCESS_KEY_ID).toBe("selected");
+		expect(auth?.auth.apiKey).toBeUndefined();
+	});
+	it.each(["credential_process=never-execute", "role_arn=arn:aws:iam::123:role/role\ncredential_source=Environment"])(
+		"rejects incompatible AWS mode before resolution: %s",
+		async (mode) => {
+			await writeFile(join(host.home, ".aws", "config"), `[profile selected]\n${mode}\n`);
+			await expect(resolveSelectedAwsProfile("selected", {}, signal())).rejects.toThrow(
+				/credential_process|ambient/,
+			);
+		},
+	);
+	it("rejects commands in a selected AWS source-profile chain", async () => {
+		await writeFile(
+			join(host.home, ".aws", "config"),
+			"[profile selected]\nrole_arn=arn:aws:iam::123:role/role\nsource_profile=source\n[profile source]\ncredential_process=never-execute\n",
+		);
+		await expect(resolveSelectedAwsProfile("selected", {}, signal())).rejects.toThrow(/credential_process/);
+	});
+	it("uses selected Google file credentials ahead of administrative keys", async () => {
+		const selected = {
+			type: "authorized_user",
+			client_id: "personal",
+			client_secret: "secret",
+			refresh_token: "!literal",
+		};
+		const file = join(host.home, "selected.json");
+		await writeFile(file, JSON.stringify(selected));
+		const auth = await googleVertexProvider().auth.apiKey!.resolve({
+			ctx: context({
+				GOOGLE_CLOUD_PROJECT: "managed",
+				GOOGLE_CLOUD_LOCATION: "region",
+				GOOGLE_CLOUD_API_KEY: "admin",
+			}),
+			credential: { type: "api_key", env: { GOOGLE_APPLICATION_CREDENTIALS: file } },
+			signal: signal(),
+		});
+		expect(explicitGoogleCredentials(auth?.env)).toEqual(selected);
+		expect(auth?.env?.GOOGLE_CLOUD_API_KEY).toBe("");
+		expect(auth?.auth.apiKey).toBeUndefined();
+	});
+	it("reads only the explicitly selected native ADC location", async () => {
+		await mkdir(join(host.home, ".config", "gcloud"), { recursive: true });
+		const selected = {
+			type: "authorized_user",
+			client_id: "selected",
+			client_secret: "secret",
+			refresh_token: "$literal",
+		};
+		await writeFile(
+			join(host.home, ".config", "gcloud", "application_default_credentials.json"),
+			JSON.stringify(selected),
+		);
+		vi.stubEnv("GOOGLE_APPLICATION_CREDENTIALS", "/wrong-file");
+		expect(await readSelectedGoogleCredentials(undefined, signal())).toEqual(selected);
+	});
+	it("disallows executable external-account Google authentication and admin ADC discovery", async () => {
+		expect(() =>
+			parseGoogleCredentials(
+				JSON.stringify({ type: "external_account", credential_source: { executable: { command: "never-run" } } }),
+				false,
+			),
+		).toThrow(/Executable/);
+		expect(() =>
+			parseGoogleCredentials(
+				JSON.stringify({ type: "authorized_user", client_id: "a", client_secret: "s", refresh_token: "r" }),
+				true,
+			),
+		).toThrow(/service-account/);
+		const ctx = context({});
+		vi.stubEnv("GOOGLE_APPLICATION_CREDENTIALS", "/unselected.json");
+		vi.stubEnv("GOOGLE_CLOUD_API_KEY", "ambient");
+		expect(await googleVertexProvider().auth.apiKey!.resolve({ ctx, signal: signal() })).toBeUndefined();
+		expect(ctx.fileExists).not.toHaveBeenCalled();
+	});
+	it("retains native external-account authorized-user ADC without ambient discovery", () => {
+		const credentials = parseGoogleCredentials(
+			JSON.stringify({
+				type: "external_account_authorized_user",
+				client_id: "selected",
+				client_secret: "secret",
+				refresh_token: "opaque",
+			}),
+			false,
+		);
+		expect(createSelectedGoogleAuthClient(credentials)).toBeInstanceOf(ExternalAccountAuthorizedUserClient);
+	});
+	it("keeps selected AWS federation while excluding ambient AWS identity and region", async () => {
+		vi.stubEnv("AWS_ACCESS_KEY_ID", "ambient");
+		vi.stubEnv("AWS_SECRET_ACCESS_KEY", "ambient-secret");
+		vi.stubEnv("AWS_REGION", "ambient-region");
+		const client = createSelectedGoogleAuthClient({
+			type: "external_account",
+			audience: "//iam.googleapis.com/projects/123/locations/global/workloadIdentityPools/pool/providers/provider",
+			subject_token_type: "urn:ietf:params:aws:token-type:aws4_request",
+			token_url: "https://sts.googleapis.com/v1/token",
+			credential_source: {
+				environment_id: "aws1",
+				region_url: "http://metadata.test/region",
+				url: "http://metadata.test/credentials",
+				regional_cred_verification_url:
+					"https://sts.{region}.amazonaws.com?Action=GetCallerIdentity&Version=2011-06-15",
+			},
+		});
+		expect(client).toBeInstanceOf(AwsClient);
+		const requests: string[] = [];
+		vi.spyOn(client.transporter, "request").mockImplementation((async (options: { url?: unknown }) => {
+			const url = String(options.url);
+			requests.push(url);
+			return {
+				data: url.endsWith("/region")
+					? "eu-west-1a"
+					: url.endsWith("/credentials")
+						? "role"
+						: { AccessKeyId: "selected", SecretAccessKey: "selected-secret", Token: "selected-token" },
+			};
+		}) as never);
+		const token = decodeURIComponent(await (client as AwsClient).retrieveSubjectToken());
+		expect(requests).toEqual([
+			"http://metadata.test/region",
+			"http://metadata.test/credentials",
+			"http://metadata.test/credentials/role",
+		]);
+		expect(token).toContain("sts.eu-west-1.amazonaws.com");
+		expect(token).toContain("Credential=selected/");
+		expect(token).not.toContain("ambient");
+	});
+});
