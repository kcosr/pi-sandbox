+
+const MAXIMUM_CLOUD_CREDENTIAL_BYTES = 1024 * 1024;
+
+async function readSelectedFile(path: string, optional = false): Promise<string | undefined> {
+	if (!isAbsolute(path) || path.includes("\0")) throw new Error("Credential source requires an absolute file path");
+	let file: FileHandle;
+	try {
+		file = await open(path, constants.O_RDONLY | constants.O_NONBLOCK);
+	} catch (error) {
+		if (optional && (error as NodeJS.ErrnoException).code === "ENOENT") return undefined;
+		throw new Error("Selected cloud credential file is unavailable");
+	}
+	try {
+		const metadata = await file.stat();
+		if (!metadata.isFile() || metadata.size > MAXIMUM_CLOUD_CREDENTIAL_BYTES)
+			throw new Error("Cloud credential file exceeds its bounds");
+		const bytes = Buffer.alloc(MAXIMUM_CLOUD_CREDENTIAL_BYTES + 1);
+		let length = 0;
+		while (length < bytes.length) {
+			const { bytesRead } = await file.read(bytes, length, bytes.length - length, null);
+			if (!bytesRead) break;
+			length += bytesRead;
+		}
+		if (length > MAXIMUM_CLOUD_CREDENTIAL_BYTES) throw new Error("Cloud credential file exceeds its bounds");
+		return new TextDecoder("utf-8", { fatal: true, ignoreBOM: true }).decode(bytes.subarray(0, length));
+	} finally {
+		await file.close();
+	}
+}
