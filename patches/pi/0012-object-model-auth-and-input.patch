+type OpenAIOptions = NonNullable<ConstructorParameters<typeof OpenAI>[0]>;
+
+import { isAuthoritativeProviderEnv } from "../utils/provider-env.ts";
+
+/** The SDK additionally reads account IDs and OPENAI_CUSTOM_HEADERS outside Pi's resolver. */
+export class PiOpenAI extends OpenAI {
+	constructor(options: OpenAIOptions & ManagedOptions) {
+		const { managedEnvironment, ...sdk } = options;
+		const managed = isAuthoritativeProviderEnv(managedEnvironment);
+		super(managed ? explicitOptions(sdk, managedEnvironment!) : sdk);
+		if (managed) {
+			this._options.defaultHeaders = sdk.defaultHeaders;
+			Object.assign(this._options, { managedEnvironment });
+		}
+	}
+}
