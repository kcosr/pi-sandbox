@@ -0,0 +1,102 @@
+import { readFileSync, unlinkSync } from "node:fs";
+import { describe, expect, it, vi } from "vitest";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.ts";
+
+// These contexts exercise the real native adapters without opening a terminal.
+function mode(state = "idle", checkpoint = vi.fn(async () => {})) {
+	const text = "message\n/attachment.png";
+	const session = {
+		isCompacting: state === "compacting",
+		isStreaming: state === "streaming",
+		isBashRunning: false,
+		prompt: vi.fn(async () => {}),
+		extensionRunner: { getCommand: (name: string) => (name === "sandbox" ? {} : undefined) },
+	};
+	const editor = {
+		onSubmit: undefined as ((text: string) => Promise<void>) | undefined,
+		getText: () => text,
+		setText: vi.fn(),
+		addToHistory: vi.fn(),
+	};
+	const instance = Object.assign(Object.create(InteractiveMode.prototype), {
+		runtimeHost: { session },
+		options: { beforeExternalMessage: checkpoint },
+		defaultEditor: editor,
+		editor,
+		pendingUserInputs: [],
+		compactionQueuedMessages: [],
+		showError: vi.fn(),
+		showStatus: vi.fn(),
+		flushPendingBashComponents: vi.fn(),
+		updatePendingMessagesDisplay: vi.fn(),
+		ui: { requestRender: vi.fn() },
+		handleBashCommand: vi.fn(async () => {}),
+		updateEditorBorderColor: vi.fn(),
+	});
+	instance.setupEditorSubmitHandler();
+	return { instance, session, editor, checkpoint, text };
+}
+
+describe("TUI external input checkpoint", () => {
+	it.each(["idle", "streaming", "compacting"])(
+		"rejects %s input before any queue and restores text/attachments",
+		async (state) => {
+			const { instance, session, editor, text } = mode(
+				state,
+				vi.fn(async () => {
+					throw new Error("offline");
+				}),
+			);
+			await editor.onSubmit!(text);
+			expect(instance.pendingUserInputs).toEqual([]);
+			expect(instance.compactionQueuedMessages).toEqual([]);
+			expect(session.prompt).not.toHaveBeenCalled();
+			expect(editor.setText).toHaveBeenCalledWith(text);
+			expect(editor.addToHistory).toHaveBeenCalledWith(text);
+			expect(instance.showError).toHaveBeenCalledWith("offline");
+		},
+	);
+	it.each(["idle", "streaming", "compacting"])("checks Alt+Enter once in %s", async (state) => {
+		const { instance, checkpoint } = mode(state);
+		await instance.handleFollowUp();
+		await Promise.resolve();
+		expect(checkpoint).toHaveBeenCalledOnce();
+	});
+	it.each(["idle", "streaming", "compacting"])("registered commands bypass failure in %s", async (state) => {
+		const { editor, checkpoint } = mode(
+			state,
+			vi.fn(async () => {
+				throw new Error("offline");
+			}),
+		);
+		await editor.onSubmit!("/sandbox");
+		expect(checkpoint).not.toHaveBeenCalled();
+	});
+	it("human shell commands bypass the checkpoint", async () => {
+		const { editor, checkpoint, instance } = mode("idle");
+		await editor.onSubmit!("!pwd");
+		expect(checkpoint).not.toHaveBeenCalled();
+		expect(instance.handleBashCommand).toHaveBeenCalledWith("pwd", false);
+	});
+	it("restores rejected initial images as ordinary editable attachments", async () => {
+		const { instance, editor } = mode(
+			"idle",
+			vi.fn(async () => {
+				throw new Error("offline");
+			}),
+		);
+		expect(
+			await instance.acceptExternalInput("initial", [
+				{ type: "image", mimeType: "image/png", data: Buffer.from("image bytes").toString("base64") },
+			]),
+		).toBe(false);
+		const restored = editor.setText.mock.calls[0]![0] as string;
+		const file = restored.split("\n")[1]!;
+		try {
+			expect(readFileSync(file, "utf8")).toBe("image bytes");
+		} finally {
+			unlinkSync(file);
+		}
+		expect(restored.startsWith("initial\n")).toBe(true);
+	});
+});
