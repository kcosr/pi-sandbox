+		await expect(mismatch.getAuth("github-copilot")).rejects.toThrow();
+		expect(await mismatch.getAvailable()).toEqual([]);
+	});
+	test("no-refresh output does not refresh or mutate an admitted OAuth record", async () => {
+		const store = new InMemoryCredentialStore();
