+// Enumerable symbols survive ordinary object spreads without becoming environment keys.
+const AUTHORITATIVE_ENV = Symbol.for("pi.authoritative-provider-environment");
+const GOOGLE_AUTH_CLIENT = Symbol.for("pi.explicit-google-auth-client");
+const GOOGLE_CREDENTIALS = Symbol.for("pi.explicit-google-credentials");
+
+export function isAuthoritativeProviderEnv(env: ProviderEnv | undefined): boolean {
+	return env !== undefined && (env as Record<symbol, unknown>)[AUTHORITATIVE_ENV] === true;
+}
+
+/** Snapshot a complete environment instead of an overlay on the host process. */
+export function authoritativeProviderEnv(values: Readonly<Record<string, string>>): ProviderEnv {
+	return Object.freeze({ ...values, [AUTHORITATIVE_ENV]: true });
