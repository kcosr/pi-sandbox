+		const result = await runtime({ "kimi-coding": provider() }, {}, ["kimi-coding"], store);
+		const modify = vi.spyOn(store, "modify");
+		const refresh = vi
+			.spyOn(result.getProvider("kimi-coding")!.auth.oauth!, "refresh")
+			.mockRejectedValue(new Error("must not refresh"));
+		await expect(getProviderCredential("kimi-coding", result, { refresh: false })).resolves.toBe("!literal");
