+		await expect(result.getAuth("custom")).rejects.toThrow();
+		expect((await result.getAvailable()).map((model) => model.provider)).toEqual(["good"]);
+	});
+	test.each(["apiKey", "env"])("rejects SDK %s before reading personal credentials", async (key) => {
+		const store = new InMemoryCredentialStore();
+		const read = vi.spyOn(store, "read");
+		const result = await runtime({ custom: provider({ apiKey: "managed" }) }, {}, ["custom"], store);
+		await expect(result.getAuth("custom", { [key]: key === "env" ? {} : "override" })).rejects.toThrow(/override/);
+		expect(read).not.toHaveBeenCalled();
