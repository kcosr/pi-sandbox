@@ -0,0 +1,49 @@
+import { mkdtempSync, readFileSync, rmSync, statSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { FileAuthStorageBackend } from "../src/core/auth-storage.ts";
+
+let directory: string;
+let path: string;
+beforeEach(() => {
+	directory = mkdtempSync(join(tmpdir(), "pi-bounded-auth-"));
+	path = join(directory, "auth.json");
+});
+afterEach(() => rmSync(directory, { recursive: true, force: true }));
+describe("bounded atomic credential backend", () => {
+	it("serializes concurrent raw mutations without losing records", async () => {
+		const backend = new FileAuthStorageBackend(path, { maximumBytes: 1024, atomicWrites: true });
+		await Promise.all(
+			Array.from({ length: 8 }, (_, id) =>
+				backend.withLockAsync(async (current) => {
+					const value = JSON.parse(current ?? "{}");
+					value[id] = "!literal $KEY";
+					await Promise.resolve();
+					return { result: undefined, next: JSON.stringify(value) };
+				}),
+			),
+		);
+		expect(Object.keys(JSON.parse(readFileSync(path, "utf8")))).toHaveLength(8);
+		expect(statSync(path).mode & 0o777).toBe(0o600);
+	});
+	it("rejects oversized writes without replacing the original document", async () => {
+		writeFileSync(path, "{}");
+		const backend = new FileAuthStorageBackend(path, { maximumBytes: 10, atomicWrites: true });
+		await expect(backend.withLockAsync(async () => ({ result: undefined, next: "x".repeat(11) }))).rejects.toThrow(
+			/bounds/,
+		);
+		expect(readFileSync(path, "utf8")).toBe("{}");
+	});
+	it("rejects malformed UTF-8 and oversized reads before invoking a callback", async () => {
+		const backend = new FileAuthStorageBackend(path, { maximumBytes: 10, atomicWrites: true });
+		writeFileSync(path, Buffer.from([0xff]));
+		await expect(
+			backend.withLockAsync(async () => {
+				throw new Error("callback must not run");
+			}),
+		).rejects.not.toThrow(/callback/);
+		writeFileSync(path, "x".repeat(11));
+		await expect(backend.withLockAsync(async () => ({ result: undefined }))).rejects.toThrow(/bounds/);
+	});
+});
