+export function parseGoogleCredentials(value: string, serviceAccountOnly: boolean): Record<string, unknown> {
+	let parsed: unknown;
+	try {
+		parsed = JSON.parse(value);
+	} catch {
+		throw new Error("Configured Google credentials are not valid JSON");
+	}
+	if (!parsed || typeof parsed !== "object" || Array.isArray(parsed))
+		throw new Error("Configured Google credentials must be an object");
+	const credentials = parsed as Record<string, unknown>;
+	if (serviceAccountOnly && credentials.type !== "service_account")
+		throw new Error("Administrative Google credentials must be self-contained service-account JSON");
+	if (credentials.type === "service_account") {
+		if (
+			typeof credentials.client_email !== "string" ||
+			!credentials.client_email ||
+			typeof credentials.private_key !== "string" ||
+			!credentials.private_key
+		)
+			throw new Error("Google service-account credentials require client_email and private_key");
+	} else if (credentials.type === "authorized_user" || credentials.type === "external_account_authorized_user") {
+		for (const field of ["client_id", "client_secret", "refresh_token"])
+			if (typeof credentials[field] !== "string" || !credentials[field])
+				throw new Error("Google ADC credentials are incomplete");
+	} else if (credentials.type === "external_account") {
+		const source = credentials.credential_source;
+		if (!source || typeof source !== "object" || Array.isArray(source))
+			throw new Error("Google external-account credentials require an explicit source");
+		if ("executable" in source) throw new Error("Executable Google external-account authentication is not permitted");
+	} else if (credentials.type === "impersonated_service_account") {
+		parseGoogleCredentials(JSON.stringify(credentials.source_credentials), false);
+	} else throw new Error("Unsupported selected Google credential source");
+	return credentials;
+}
+
+export async function readSelectedGoogleCredentials(
+	path: string | undefined,
+	signal: AbortSignal,
+): Promise<Record<string, unknown>> {
+	signal.throwIfAborted();
+	const home = userInfo().homedir;
+	const selected = path?.startsWith("~/")
+		? join(home, path.slice(2))
+		: (path ?? join(home, ".config", "gcloud", "application_default_credentials.json"));
+	const content = await readSelectedFile(selected);
+	signal.throwIfAborted();
+	return parseGoogleCredentials(content!, false);
+}
+
+/** Keep native Google credential types while removing AWS federation's implicit shell credentials. */
+export function createSelectedGoogleAuthClient(credentials: Record<string, unknown>): AuthClient {
+	class SelectedGoogleAuth extends GoogleAuth {
+		override fromJSON(
+			json: Parameters<GoogleAuth["fromJSON"]>[0],
+			options?: Parameters<GoogleAuth["fromJSON"]>[1],
+		): ReturnType<GoogleAuth["fromJSON"]> {
+			const client = super.fromJSON(json, options);
+			if (client instanceof AwsClient) {
+				const source = (json as unknown as { credential_source: Record<string, unknown> }).credential_source;
+				const regionUrl = source.region_url;
+				const credentialsUrl = source.url;
+				if (typeof regionUrl !== "string" || typeof credentialsUrl !== "string")
+					throw new Error("Selected Google AWS federation requires explicit metadata credential and region URLs");
+				const headers = async (
+					context: Parameters<AwsSecurityCredentialsSupplier["getAwsRegion"]>[0],
+				): Promise<Record<string, string>> => {
+					const tokenUrl = source.imdsv2_session_token_url;
+					if (tokenUrl === undefined) return {};
+					if (typeof tokenUrl !== "string") throw new Error("Invalid Google AWS metadata token URL");
+					const response = await context.transporter.request<string>({
+						url: tokenUrl,
+						method: "PUT",
+						responseType: "text",
+						headers: { "x-aws-ec2-metadata-token-ttl-seconds": "300" },
+					});
+					return { "x-aws-ec2-metadata-token": response.data };
+				};
+				const supplier: AwsSecurityCredentialsSupplier = {
+					getAwsRegion: async (context) => {
+						const response = await context.transporter.request<string>({
+							url: regionUrl,
+							method: "GET",
+							responseType: "text",
+							headers: await headers(context),
+						});
+						if (typeof response.data !== "string" || response.data.length < 2)
+							throw new Error("Invalid selected AWS region");
+						return response.data.slice(0, -1);
+					},
+					getAwsSecurityCredentials: async (context) => {
+						const requestHeaders = await headers(context);
+						const role = await context.transporter.request<string>({
+							url: credentialsUrl,
+							method: "GET",
+							responseType: "text",
+							headers: requestHeaders,
+						});
+						if (typeof role.data !== "string" || !role.data) throw new Error("Invalid selected AWS role");
+						const response = await context.transporter.request<{
+							AccessKeyId: string;
+							SecretAccessKey: string;
+							Token?: string;
+						}>({
+							url: `${credentialsUrl}/${role.data}`,
+							method: "GET",
+							responseType: "json",
+							headers: requestHeaders,
+						});
+						if (!response.data.AccessKeyId || !response.data.SecretAccessKey)
+							throw new Error("Invalid selected AWS credentials");
+						return {
+							accessKeyId: response.data.AccessKeyId,
+							secretAccessKey: response.data.SecretAccessKey,
+							token: response.data.Token,
+						};
+					},
+				};
+				// Pinned google-auth-library exposes no supplier replacement with native JSON
+				// routing preserved. Fence this one internal seam and exercise the real signer.
+				if (!("awsSecurityCredentialsSupplier" in client))
+					throw new Error("Unsupported Google AWS credential supplier seam");
+				Object.defineProperty(client, "awsSecurityCredentialsSupplier", { value: supplier });
+			}
+			return client;
+		}
+	}
+	return new SelectedGoogleAuth({ scopes: ["https://www.googleapis.com/auth/cloud-platform"] }).fromJSON(credentials);
+}
