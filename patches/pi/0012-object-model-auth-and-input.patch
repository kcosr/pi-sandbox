+	});
+	test("does not read unadmitted personal records, including credential output", async () => {
+		const store = new InMemoryCredentialStore();
+		const read = vi.spyOn(store, "read").mockRejectedValue(new Error("must not read"));
+		const result = await runtime({ custom: provider({ apiKey: "managed" }) }, {}, [], store);
+		await expect(getProviderCredential("custom", result, { refresh: false })).resolves.toBe("managed");
