+/** Native command lookup shared by external adapters; never called by queue drains. */
+export function isRegisteredCommand(session: AgentSession, text: string): boolean {
+	if (!text.startsWith("/")) return false;
+	const space = text.indexOf(" ");
+	return !!session.extensionRunner.getCommand(space === -1 ? text.slice(1) : text.slice(1, space));
+}
+
+export async function beforeExternalInput(
+	session: AgentSession,
+	text: string,
+	checkpoint: (() => Promise<void>) | undefined,
+): Promise<void> {
+	if (checkpoint && !isRegisteredCommand(session, text)) await checkpoint();
+}
