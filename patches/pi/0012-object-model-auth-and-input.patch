+import { afterEach, describe, expect, it, vi } from "vitest";
+import { authoritativeProviderEnv } from "../src/utils/provider-env.ts";
+
+const callbacks = vi.hoisted(() => ({ hosts: [] as string[] }));
+vi.mock("../src/auth/oauth/callback-server.ts", async (original) => ({
+	...(await original<typeof import("../src/auth/oauth/callback-server.ts")>()),
+	startOAuthCallbackServer: async (options: { host: string }) => {
+		callbacks.hosts.push(options.host);
+		throw new Error("offline callback fixture");
+	},
+}));
+vi.mock("node:http", async (original) => ({
+	...(await original<typeof import("node:http")>()),
+	createServer: () => {
+		let onError: ((error: Error) => void) | undefined;
+		const server = {
+			on: (_event: string, fn: (error: Error) => void) => {
+				onError = fn;
+				return server;
+			},
+			once: (_event: string, fn: (error: Error) => void) => {
+				onError = fn;
+				return server;
+			},
+			listen: (_port: number, host: string) => {
+				callbacks.hosts.push(host);
+				queueMicrotask(() => onError?.(new Error("offline callback fixture")));
+			},
+			close: () => {},
+			removeListener: () => server,
+		};
+		return server;
+	},
+}));
+const authContext = (values: Record<string, string> = {}) => ({
+	environment: authoritativeProviderEnv(values),
+	authoritative: true,
+	env: async (key: string) => values[key],
+	fileExists: async () => false,
+});
+const interaction = () => ({
+	signal: new AbortController().signal,
+	prompt: vi.fn(async () => "browser"),
+	notify: vi.fn(),
+	openUrl: vi.fn(async () => {}),
+});
+afterEach(() => {
+	vi.unstubAllEnvs();
+	vi.unstubAllGlobals();
+	callbacks.hosts.length = 0;
+});
+describe("operation-scoped authoritative OAuth environment", () => {
+	it("does not read a hostile pre-import Kimi refresh host", async () => {
+		vi.stubEnv("KIMI_CODE_OAUTH_HOST", "https://evil.test");
+		const { kimiCodingOAuth } = await import("../src/auth/oauth/kimi-coding.ts");
+		const urls: string[] = [];
+		vi.stubGlobal(
+			"fetch",
+			vi.fn(async (url: string) => {
+				urls.push(String(url));
+				return new Response(JSON.stringify({ access_token: "new", refresh_token: "r", expires_in: 3600 }), {
+					status: 200,
+				});
+			}),
+		);
+		await kimiCodingOAuth.refresh(
+			{ type: "oauth", access: "a", refresh: "r", expires: 0 },
+			new AbortController().signal,
+			authContext(),
+		);
+		expect(urls[0]).not.toContain("evil.test");
+		await kimiCodingOAuth.refresh(
+			{ type: "oauth", access: "a", refresh: "r", expires: 0 },
+			new AbortController().signal,
+			authContext({ KIMI_CODE_OAUTH_HOST: "https://configured.test" }),
+		);
+		expect(urls[1]).toContain("https://configured.test/");
+	});
+	it("Anthropic callback settings use the captured map after module import", async () => {
+		vi.stubEnv("PI_OAUTH_CALLBACK_HOST", "hostile-before-import");
+		const { anthropicOAuth } = await import("../src/auth/oauth/anthropic.ts");
+		await expect(
+			anthropicOAuth.login!(interaction(), { authContext: authContext({ PI_OAUTH_CALLBACK_HOST: "configured" }) }),
+		).rejects.toThrow();
+		expect(callbacks.hosts.length).toBeGreaterThan(0);
+		expect(callbacks.hosts.every((host) => host === "configured")).toBe(true);
+	});
+	it("OpenAI callback settings use the native default when missing from the map", async () => {
+		vi.stubEnv("PI_OAUTH_CALLBACK_HOST", "hostile-before-import");
+		const { openaiChatGPTOAuth } = await import("../src/auth/oauth/openai-chatgpt.ts");
+		await expect(
+			openaiChatGPTOAuth.login!(interaction(), {
+				authContext: authContext(),
+				getDeviceId: () => "12345678-1234-1234-1234-123456789abc",
+			}),
+		).rejects.toThrow();
+		expect(callbacks.hosts).toEqual(["127.0.0.1"]);
+	});
+});
