diff --git a/packages/ai/src/auth/explicit-cloud-loader.ts b/packages/ai/src/auth/explicit-cloud-loader.ts
new file mode 100644
index 0000000..8fc9e02
--- /dev/null
+++ b/packages/ai/src/auth/explicit-cloud-loader.ts
@@ -0,0 +1,13 @@
+type ExplicitCloud = typeof import("./explicit-cloud.ts");
+let bundled: (() => ExplicitCloud) | undefined;
+
+/** Node-only personal source readers follow the same bundling seam as OAuth. */
+export function registerBundledExplicitCloud(loader: () => ExplicitCloud): void {
+	bundled = loader;
+}
+
+export async function loadExplicitCloud(): Promise<ExplicitCloud> {
+	if (bundled) return bundled();
+	const specifier = import.meta.url.endsWith(".js") ? "./explicit-cloud.js" : "./explicit-cloud.ts";
+	return import(specifier);
+}
