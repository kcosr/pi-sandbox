+		await expect(result.removeRuntimeApiKey("custom")).rejects.toThrow(/override/);
+	});
+	test("rejects commands, unconfigured admission, unadmitted Radius and unknown APIs", async () => {
+		await expect(runtime({ custom: provider({ apiKey: "!command" }) })).rejects.toThrow(/command/);
+		await expect(runtime({ custom: provider() }, {}, ["absent"])).rejects.toThrow(/unconfigured/);
+		await expect(runtime({ custom: provider({ oauth: "radius" }) })).rejects.toThrow(/Radius/);
+		expect((await runtime({ custom: provider({ api: "unknown-api" }) })).getError()).toMatch(/Unknown model API/);
+	});
+	test("personal authentication rejects configured authorization headers", async () => {
+		const store = new InMemoryCredentialStore();
+		await store.modify("custom", async () => ({ type: "api_key", key: "personal" }));
+		const result = await runtime(
