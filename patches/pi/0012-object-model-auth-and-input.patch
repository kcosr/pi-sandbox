+/** Resolve only the selected native profile from immutable in-memory SDK inputs. */
+export async function resolveSelectedAwsProfile(
+	profile: string,
+	environment: ProviderEnv,
+	signal: AbortSignal,
+): Promise<ProviderEnv> {
+	signal.throwIfAborted();
+	const home = userInfo().homedir;
+	const [credentials, configuration] = await Promise.all([
+		readSelectedFile(join(home, ".aws", "credentials"), true),
+		readSelectedFile(join(home, ".aws", "config"), true),
+	]);
+	// The SDK supports in-memory file interception. Unique names fence concurrent requests
+	// and prevent a second filesystem read from introducing credential_process after validation.
+	const id = randomUUID();
+	const filepath = `pi-explicit-credentials:${id}`;
+	const configFilepath = `pi-explicit-config:${id}`;
+	externalDataInterceptor.interceptFile(filepath, credentials ?? "");
+	externalDataInterceptor.interceptFile(configFilepath, configuration ?? "");
+	try {
+		const options = { profile, filepath, configFilepath, ignoreCache: true };
+		const profiles = await parseKnownFiles(options);
+		const visited = new Set<string>();
+		let current: string | undefined = profile;
+		while (current !== undefined) {
+			if (visited.has(current) || visited.size >= 32)
+				throw new Error("Selected AWS profile has an invalid source chain");
+			visited.add(current);
+			const selected: Record<string, string | undefined> | undefined = profiles[current];
+			if (!selected) throw new Error("Selected AWS profile is unavailable");
+			if (selected.credential_process !== undefined) throw new Error("AWS credential_process is not permitted");
+			if (selected.credential_source === "Environment")
+				throw new Error("AWS profiles cannot select ambient environment credentials");
+			current = selected.source_profile;
+		}
+		signal.throwIfAborted();
+		const clientConfig = {
+			region: environment.AWS_REGION ?? environment.AWS_DEFAULT_REGION ?? profiles[profile]?.region ?? "us-east-1",
+			ignoreConfiguredEndpointUrls: true,
+			maxAttempts: 1,
+		};
+		const resolved = await fromIni({ ...options, clientConfig })({
+			callerClientConfig: {
+				...clientConfig,
+				region: () => Promise.resolve(clientConfig.region),
+			},
+		});
+		signal.throwIfAborted();
+		return {
+			AWS_ACCESS_KEY_ID: resolved.accessKeyId,
+			AWS_SECRET_ACCESS_KEY: resolved.secretAccessKey,
+			...(resolved.sessionToken ? { AWS_SESSION_TOKEN: resolved.sessionToken } : { AWS_SESSION_TOKEN: "" }),
+			AWS_BEARER_TOKEN_BEDROCK: "",
+			AWS_PROFILE: "",
+		};
+	} finally {
+		delete externalDataInterceptor.getFileRecord()[filepath];
+		delete externalDataInterceptor.getFileRecord()[configFilepath];
+	}
+}
