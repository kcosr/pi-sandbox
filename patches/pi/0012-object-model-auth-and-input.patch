+const provider = (extra: Record<string, unknown> = {}) => ({
+	api: "openai-completions",
+	baseUrl: "https://configured.test/v1",
+	models: [{ id: "model" }],
+	...extra,
+});
+async function runtime(
+	providers: Record<string, unknown>,
+	environment: Record<string, string> = {},
+	personalProviders: string[] = [],
+	credentials: CredentialStore = new InMemoryCredentialStore(),
+) {
+	return ModelRuntime.create({
+		modelsConfig: { providers },
+		credentials,
+		modelsStore: new InMemoryModelsStore(),
+		includeBuiltinCatalog: false,
+		allowModelNetwork: false,
+		refreshOnCreate: false,
+		authPolicy: { environment, personalProviders },
+	});
+}
+afterEach(() => {
+	vi.restoreAllMocks();
+	vi.unstubAllEnvs();
+});
+describe("authoritative object model runtime", () => {
+	test("object catalog survives mutation and refresh without reading models.json", async () => {
+		const source = { custom: provider({ apiKey: "literal" }) };
+		const result = await runtime(source);
+		source.custom.models = [{ id: "changed" }];
+		await result.refresh({ allowNetwork: false });
+		expect(result.getModels().map((model) => model.id)).toEqual(["model"]);
+		expect(result.getError()).toBeUndefined();
+	});
+	test("keys and headers resolve only captured environment with no ambient repair", async () => {
+		vi.stubEnv("ADMIN_KEY", "ambient");
+		vi.stubEnv("MISSING", "ambient");
+		const env = { ADMIN_KEY: "!literal $opaque", USERNAME: "managed" };
+		const result = await runtime(
+			{
+				custom: provider({ apiKey: "$ADMIN_KEY", headers: { "X-User": "$USERNAME" } }),
+				absent: provider({ apiKey: "$MISSING" }),
