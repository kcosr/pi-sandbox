diff --git a/packages/coding-agent/src/core/authoritative-auth.ts b/packages/coding-agent/src/core/authoritative-auth.ts
new file mode 100644
index 0000000..d2ca42d
--- /dev/null
+++ b/packages/coding-agent/src/core/authoritative-auth.ts
@@ -0,0 +1,142 @@
+import type { AnyModel, AuthResult, CredentialStore, ModelAuth, ProviderHeaders } from "@earendil-works/pi-ai";
+import type { ModelConfig } from "./model-config.ts";
+import { isCommandConfigValue, resolveHeadersOrThrow } from "./resolve-config-value.ts";
+
+/** Optional authority supplied by an embedding application, independent of storage or transport. */
+export interface ModelRuntimeAuthPolicy {
+	readonly environment: Readonly<Record<string, string>>;
+	readonly personalProviders: readonly string[];
+}
+
+const PERSONAL_AUTH = Symbol("personal-authentication");
+type PersonalAuth = ModelAuth & { [PERSONAL_AUTH]?: { headers?: ProviderHeaders; apiKey: boolean } };
+
+export function validateAuthoritativeCatalog(config: ModelConfig, policy: ModelRuntimeAuthPolicy): void {
+	if (config.getError()) throw new Error(config.getError());
+	const providers = new Set(config.getProviderIds());
+	if (new Set(policy.personalProviders).size !== policy.personalProviders.length) {
+		throw new Error("Personal provider admission contains duplicates");
+	}
+	for (const id of policy.personalProviders) {
+		if (!providers.has(id)) throw new Error(`Personal authentication names an unconfigured provider: ${id}`);
+	}
+	for (const id of providers) {
+		const provider = config.getProvider(id)!;
+		if (provider.oauth === "radius" && !policy.personalProviders.includes(id)) {
+			throw new Error(`Provider ${id}: Radius requires personal authentication admission`);
+		}
+		const values = [
+			provider.apiKey,
+			...Object.values(provider.headers ?? {}),
+			...(provider.models ?? []).flatMap((model) => Object.values(model.headers ?? {})),
+			...Object.values(provider.modelOverrides ?? {}).flatMap((model) => Object.values(model.headers ?? {})),
+		];
+		if (values.some((value) => value !== undefined && isCommandConfigValue(value))) {
+			throw new Error(`Provider ${id}: command expressions are not permitted in model configuration`);
+		}
+	}
+}
+
+export function markPersonalAuth(auth: ModelAuth): ModelAuth {
+	return { ...auth, [PERSONAL_AUTH]: { headers: auth.headers, apiKey: auth.apiKey !== undefined } } as PersonalAuth;
+}
+
+export function assertPersonalHeaderConsistency(auth: ModelAuth, configured: ProviderHeaders | undefined): void {
+	const personal = (auth as PersonalAuth)[PERSONAL_AUTH];
+	if (!personal || !configured) return;
+	const supplied = new Set(Object.keys(personal.headers ?? {}).map((name) => name.toLowerCase()));
+	if (personal.apiKey) {
+		for (const name of ["authorization", "x-api-key", "api-key"]) supplied.add(name);
+	}
+	for (const name of Object.keys(configured)) {
+		if (supplied.has(name.toLowerCase())) {
+			throw new Error(`Personal authentication conflicts with configured header: ${name}`);
+		}
+	}
+}
+
+function normalizedEndpoint(value: string): string {
+	const url = new URL(value);
+	url.pathname = url.pathname.replace(/\/+$/u, "") || "/";
+	return url.href;
+}
+
+export function assertAuthMatchesModels(result: AuthResult, models: readonly AnyModel[], config: ModelConfig): void {
+	if (!(result.auth as PersonalAuth)[PERSONAL_AUTH]) return;
+	for (const model of models) {
+		if (result.auth.baseUrl && normalizedEndpoint(result.auth.baseUrl) !== normalizedEndpoint(model.baseUrl)) {
+			throw new Error(
+				`Personal authentication endpoint does not match configured model ${model.provider}/${model.id}`,
+			);
+		}
+		const provider = config.getProvider(model.provider);
+		const definition = provider?.models?.find((entry) => entry.id === model.id);
+		// Header *names* establish the authority boundary even if a variable is unavailable.
+		const headers = { ...provider?.modelOverrides?.[model.id]?.headers, ...definition?.headers };
+		assertPersonalHeaderConsistency(result.auth, headers);
+		if (
+			model.api === "openai-codex-responses" &&
+			Object.keys({ ...provider?.headers, ...headers }).some((name) => name.toLowerCase() === "chatgpt-account-id")
+		) {
+			throw new Error("Personal Codex authentication conflicts with configured chatgpt-account-id header");
+		}
+	}
+}
+
+/** Cloud routing is administrative even when the selected credential is personal. */
+export function configuredRoutingAvailable(model: AnyModel, environment: Record<string, string>): boolean {
+	if (model.api === "bedrock-converse-stream") {
+		return !!(
+			environment.AWS_REGION ||
+			environment.AWS_DEFAULT_REGION ||
+			/^https:\/\/bedrock-runtime[.-][a-z0-9-]+\.amazonaws\.com(?:\.cn)?(?:\/|$)/u.test(model.baseUrl) ||
+			/^arn:aws(?:-[a-z0-9-]+)?:bedrock:[a-z0-9-]+:/u.test(model.id)
+		);
+	}
+	if (model.api === "google-vertex") {
+		return (
+			(!model.baseUrl.includes("{location}") || !!environment.GOOGLE_CLOUD_LOCATION) &&
+			(!model.baseUrl.includes("{project}") || !!(environment.GOOGLE_CLOUD_PROJECT || environment.GCLOUD_PROJECT))
+		);
+	}
+	return true;
+}
+
+export function configuredHeadersAvailable(
+	headers: Record<string, string> | undefined,
+	environment: Record<string, string>,
+): boolean {
+	try {
+		resolveHeadersOrThrow(headers, "configured provider", environment);
+		return true;
+	} catch {
+		return false;
+	}
+}
+
+/** Admission precedes every store read; embeddings still supply a raw, validated store. */
+export function admitCredentialStore(
+	store: CredentialStore,
+	policy: ModelRuntimeAuthPolicy,
+	readOnly: boolean,
+): CredentialStore {
+	const admitted = new Set(policy.personalProviders);
+	const writable = (provider: string) => {
+		if (!admitted.has(provider)) throw new Error(`Provider ${provider} is administrator-managed`);
+		if (readOnly) throw new Error("Read-only credential inspection cannot modify storage");
+	};
+	return {
+		read: (provider, options) =>
+			admitted.has(provider) ? store.read(provider, options) : Promise.resolve(undefined),
+		list: async (options) =>
+			admitted.size ? (await store.list(options)).filter((entry) => admitted.has(entry.providerId)) : [],
+		modify: async (provider, fn, options) => {
+			writable(provider);
+			return store.modify(provider, fn, options);
+		},
+		delete: async (provider, options) => {
+			writable(provider);
+			await store.delete(provider, options);
+		},
+	};
+}
