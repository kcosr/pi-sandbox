+describe("managed native OAuth", () => {
+	test("Kimi native OAuth retains literal tokens and rejects provider/model auth-header conflicts", async () => {
+		const store = new InMemoryCredentialStore();
+		await store.modify("kimi-coding", async () => ({
+			type: "oauth",
+			access: "$literal!",
+			refresh: "refresh",
+			expires: Date.now() + 3600000,
