+++ b/packages/ai/src/api/authoritative-client-options.ts
@@ -0,0 +1,17 @@
+import type OpenAI from "openai";
+import type { ProviderEnv } from "../types.ts";
+import { getProviderEnvValue } from "../utils/provider-env.ts";
+
+type OpenAIOptions = NonNullable<ConstructorParameters<typeof OpenAI>[0]>;
+export type ManagedOptions = { managedEnvironment?: ProviderEnv };
+
+export function explicitOptions<T extends OpenAIOptions>(options: T, environment: ProviderEnv): T {
+	return {
+		...options,
+		adminAPIKey: null,
+		organization: getProviderEnvValue("OPENAI_ORG_ID", environment) ?? null,
+		project: getProviderEnvValue("OPENAI_PROJECT_ID", environment) ?? null,
+		webhookSecret: null,
+		logLevel: "warn",
+	};
+}
